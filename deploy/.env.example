# Copy to .env next to compose.yml and deploy.sh. deploy.sh manages IMAGE_TAG.
IMAGE_TAG=
# Host port the container is published on (bound to 127.0.0.1 only). On the server,
# nginx on :4000 (the cloudflared target) proxies to it.
HOST_PORT=3000
ORIGIN=https://farm.greenhill.net.au
# gbros-api's container on the shared farmstack network (a bare origin, no /api).
BACKEND_ORIGIN=http://gbros-api:8000
BODY_SIZE_LIMIT=25M
